{
  "name": "fieldbook",
  "version": "0.1.0",
  "private": true,
  "scripts": {
    "setup": "node scripts/setup.mjs",
    "dev": "next dev",
    "build": "node scripts/prisma.mjs generate && node scripts/prisma.mjs db push && next build",
    "start": "next start",
    "lint": "eslint",
    "db:generate": "node scripts/prisma.mjs generate",
    "db:push": "node scripts/prisma.mjs db push",
    "db:seed": "tsx prisma/seed.ts",
    "db:reset": "node scripts/prisma.mjs db push --force-reset && tsx prisma/seed.ts",
    "postinstall": "node scripts/prisma.mjs generate",
    "test": "tsx --test lib/validation.test.ts lib/question-types.test.ts"
  },
  "dependencies": {
    "@prisma/client": "^6.19.3",
    "bcryptjs": "^3.0.3",
    "jose": "^6.2.12",
    "next": "16.3.5",
    "react": "19.2.8",
    "react-dom": "19.2.8",
    "zod": "^4.6.2"
  },
  "devDependencies": {
    "@tailwindcss/postcss": "^4",
    "@types/bcryptjs": "^2.4.6",
    "@types/node": "^20",
    "@types/react": "^19",
    "@types/react-dom": "^19",
    "eslint": "^9",
    "eslint-config-next": "16.3.5",
    "prisma": "^6.19.3",
    "tailwindcss": "^4",
    "tsx": "^4.23.13",
    "typescript": "^5"
  }
}
