# Local demo uses a file on disk. No Postgres or cloud account needed.
DATABASE_URL="file:./dev.db"

# Used to sign researcher login cookies. Change this before deploying.
AUTH_SECRET="fieldbook-demo-secret-change-me"

# Optional. If omitted, the app uses the current request host for invite links.
# NEXT_PUBLIC_APP_URL="http://localhost:3000"

# Optional. Needed only if you want Fieldbook to send invite emails.
# Create an API key at https://resend.com and verify a sending domain.
# RESEND_API_KEY="re_xxxxxxxx"
# EMAIL_FROM="Fieldbook <studies@your-domain.com>"

# Optional. Needed only if you want to connect Google Forms.
# Create an OAuth client at https://console.cloud.google.com
# Authorized redirect URI must be: https://your-app.vercel.app/api/google/callback
# (or http://localhost:3000/api/google/callback for local testing)
# GOOGLE_CLIENT_ID=""
# GOOGLE_CLIENT_SECRET=""
